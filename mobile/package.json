{
  "name": "@pim/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test --test-reporter=spec tests/*.test.mjs",
    "bundle:ios": "expo export --platform ios --output-dir dist"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tamagui/config": "3.1.2",
    "expo": "58.0.17",
    "expo-constants": "58.0.13",
    "expo-crypto": "58.0.7",
    "expo-linking": "58.0.14",
    "expo-router": "58.0.25",
    "expo-status-bar": "58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-drawer-layout": "4.2.12",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-worklets": "0.13.0",
    "tamagui": "3.1.2"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  }
}
