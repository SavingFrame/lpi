{
  "name": "lpi",
  "private": true,
  "type": "module",
  "main": "./dist/desktop/main/index.js",
  "workspaces": [
    "mobile"
  ],
  "overrides": {
    "@react-native/metro-config": "0.86.3",
    "@tailwindcss/node": {
      "lightningcss": "1.33.0"
    },
    "expo": "57.0.31",
    "expo-font": "57.0.4",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write --error-on-warnings .",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "dev": "vite --config frontend/vite.config.ts frontend",
    "typecheck:desktop": "tsc -p desktop/tsconfig.json",
    "build:desktop": "npm run typecheck:desktop && electron-vite build --config desktop/electron.vite.config.ts --logLevel warn",
    "desktop:dev": "electron-vite dev --config desktop/electron.vite.config.ts --watch",
    "desktop:start": "npm run build:desktop && electron-vite preview --config desktop/electron.vite.config.ts --skipBuild",
    "test:desktop": "npm run build:desktop && node --experimental-strip-types --test --test-reporter=spec desktop/tests/*.test.mjs",
    "test:desktop:smoke": "npm run build:desktop && npm run build:server && node --test --test-reporter=spec desktop/tests/smoke.mjs",
    "build": "npm run build:server && npm run build:frontend",
    "build:server": "tsc -p tsconfig.json",
    "build:frontend": "vite build --config frontend/vite.config.ts frontend",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p frontend/tsconfig.json && tsc -p desktop/tsconfig.json --noEmit && npm run typecheck --workspace @lpi/mobile",
    "start": "node dist/src/main.js",
    "test:frontend": "node --experimental-strip-types --test --test-reporter=spec frontend/tests/*.test.mjs",
    "test:browser": "node --test --test-reporter=spec frontend/tests/browser/chat-scroll.mjs",
    "test:server": "npm run build:server && node --test --test-reporter=spec tests/*.test.mjs",
    "test": "npm run test:server && npm run test:frontend"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-vite": "6.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@fastify/websocket": "11.3.4",
    "@pierre/diffs": "1.5.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "acorn": "8.19.0",
    "base64-js": "1.5.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fastify": "5.12.7",
    "lucide-react": "1.60.0",
    "parse5": "8.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "uuid": "14.0.3",
    "ws": "8.22.0"
  }
}
