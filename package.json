{
  "name": "pim",
  "private": true,
  "type": "module",
  "workspaces": [
    "mobile"
  ],
  "overrides": {
    "@react-native/metro-config": "0.86.3",
    "expo": "57.0.31",
    "expo-font": "57.0.4",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write --error-on-warnings .",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "dev": "vite --config frontend/vite.config.ts frontend",
    "build": "npm run build:server && npm run build:frontend",
    "build:server": "tsc -p tsconfig.json",
    "build:frontend": "vite build --config frontend/vite.config.ts frontend",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p frontend/tsconfig.json && npm run typecheck --workspace @pim/mobile",
    "start": "node dist/main.js",
    "test:frontend": "node --experimental-strip-types --test --test-reporter=spec frontend/tests/*.test.mjs",
    "test:browser": "node --test --test-reporter=spec frontend/tests/browser/chat-scroll.mjs",
    "test:server": "npm run build:server && node --test --test-reporter=spec tests/*.test.mjs",
    "test": "npm run test:server && npm run test:frontend"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@pierre/diffs": "1.5.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "base64-js": "1.5.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.60.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "uuid": "14.0.3",
    "ws": "8.22.0"
  }
}
